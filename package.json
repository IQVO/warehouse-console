{
  "name": "warehouse-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --port 5173",
    "verify:routes": "node scripts/verify-all-routes.cjs",
    "verify:dashboards": "node scripts/verify-dashboards.cjs",
    "verify:cluster": "BASE_URL=http://localhost API_ORIGIN=http://localhost:8000 node scripts/verify-cluster.cjs",
    "test": "vitest run && npm run test:browser-scripts",
    "test:browser-scripts": "node --test scripts/browser-verify-common.test.cjs scripts/verify-cluster.test.cjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@warehouse/ui-kit": "file:../warehouse-ui-kit",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.21.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "^0.6.1",
      "undici": "^7.30.1"
    },
    "source-map-js": "^1.2.2",
    "vite": "^8.3.3",
    "fast-uri": "^3.1.9",
    "undici": "^8.12.2",
    "@vitest/mocker": "^5.0.3",
    "@vitest/ui": "^5.0.5",
    "serialize-javascript": "^7.1.3",
    "launch-editor": "^2.14.2",
    "follow-redirects": "^1.16.1",
    "qs": "^6.16.1"
  }
}
